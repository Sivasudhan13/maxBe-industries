# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/maxbe_pumps
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/maxbe_pumps
MONGO_URI=mongodb://127.0.0.1:27017/maxbe_pumps

# ─── JWT ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Admin seed (only used by npm run seed) ───────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=908090
