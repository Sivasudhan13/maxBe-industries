  <ellipse cx="344" cy="318" rx="5" ry="8" fill="#374151"/>
  <!-- Outlet pipe (top) -->
  <rect x="412" y="210" width="16" height="22" rx="4" fill="#e5e7eb" stroke="#374151" stroke-width="1.5"/>
  <!-- Base plate -->
  <rect x="370" y="338" width="100" height="10" rx="3" fill="#374151" opacity="0.3"/>
  <rect x="376" y="346" width="88" height="6" rx="2" fill="#374151" opacity="0.2"/>
  <!-- Brand badge -->
  <rect x="398" y="306" width="44" height="22" rx="6" fill="#dc2626" opacity="0.9"/>
  <text x="420" y="321" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-size="11" font-weight="900" fill="white">MAXBE</text>
