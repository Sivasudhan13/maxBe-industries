  <rect x="0" y="536" width="800" height="64" fill="white" opacity="0.92"/>
  <rect x="0" y="536" width="800" height="2" fill="#16a34a"/>
  <text x="420" y="566" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-size="20" font-weight="bold" fill="#dc2626">MB 2HP</text>
  <text x="420" y="584" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-size="12" font-weight="600" fill="#16a34a">Monoblock · 2 HP</text>
  
