    <text x="130" y="194" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-size="9" fill="#374151">Voltage</text>
    <text x="130" y="208" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-size="11" font-weight="700" fill="#374151">220-240V 50Hz</text>
  
    <rect x="42" y="224" width="176" height="38" rx="8" fill="#f0fdf4"/>
    <text x="130" y="240" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-size="9" fill="#374151">Protection</text>
    <text x="130" y="254" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-size="11" font-weight="700" fill="#374151">IP68</text>
  
    <rect x="42" y="270" width="176" height="38" rx="8" fill="#f0fdf4"/>
    <text x="130" y="286" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-size="9" fill="#374151">Body</text>
    <text x="130" y="300" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-size="11" font-weight="700" fill="#374151">Cast Iron</text>
  
    <rect x="42" y="316" width="176" height="38" rx="8" fill="#f0fdf4"/>
    <text x="130" y="332" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-size="9" fill="#374151">Impeller</text>
    <text x="130" y="346" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-size="11" font-weight="700" fill="#374151">Brass</text>
  
  
  
  <!-- Motor housing -->
