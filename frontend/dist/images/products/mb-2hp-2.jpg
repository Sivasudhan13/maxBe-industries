  <text x="43" y="33" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-size="14" font-weight="900" fill="white">MX</text>
  <text x="100" y="26" font-family="Montserrat,Arial,sans-serif" font-size="16" font-weight="900" fill="white">MAXBE PUMPS</text>
  <text x="100" y="42" font-family="Montserrat,Arial,sans-serif" font-size="9" font-weight="600" fill="rgba(255,255,255,0.7)">MONOBLOCK</text>
  
  <!-- Specs panel on view 2 -->
  <rect x="30" y="80" width="200" height="300" rx="16" fill="white" opacity="0.9"/>
  <rect x="30" y="80" width="200" height="6" rx="3" fill="#dc2626"/>
  <text x="130" y="112" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-size="10" font-weight="700" fill="#374151">SPECIFICATIONS</text>
  
    <rect x="42" y="132" width="176" height="38" rx="8" fill="#f0fdf4"/>
    <text x="130" y="148" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-size="9" fill="#374151">Motor Power</text>
    <text x="130" y="162" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-size="11" font-weight="700" fill="#374151">2 HP</text>
  
