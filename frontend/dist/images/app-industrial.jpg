<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <rect width="800" height="600" fill="#1c1917"/>
  
  <defs>
    <linearGradient id="appGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#1c1917"/>
      <stop offset="100%" stop-color="#0c0a09"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#appGrad)"/>
  <!-- Icon circle -->
  <circle cx="400" cy="250" r="90" fill="rgba(255,255,255,0.12)"/>
  <circle cx="400" cy="250" r="68" fill="rgba(255,255,255,0.18)"/>
  <text x="400" y="280" text-anchor="middle" font-size="72" font-family="Arial,sans-serif">🏭</text>
  <!-- Title -->
  <rect x="0" y="490" width="800" height="110" fill="rgba(0,0,0,0.45)"/>
  <rect x="0" y="488" width="800" height="3" fill="#dc2626"/>
  <text x="400" y="532" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-size="34" font-weight="900" fill="white">Industrial</text>
  <text x="400" y="562" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-size="14" fill="rgba(255,255,255,0.75)">MAXBE PUMPS Application</text>
  <!-- Corner badge -->
  <rect x="20" y="20" width="100" height="36" rx="8" fill="#dc2626"/>
  <text x="70" y="43" text-anchor="middle" font-family="Montserrat,Arial,sans-serif" font-size="13" font-weight="900" fill="white">MAXBE</text>
  
</svg>